<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Switcheroo 浮层（switcheroo-winui）的应用程序清单。

  做两件事：
    1. 依赖 comctl32 v6（Common-Controls 6.0）：让原生控件（输入框）走 v6 的视觉样式。
       注意占位文案（S9）已经改成由渲染器自己画，不再依赖 v6 EDIT 的 `EM_SETCUEBANNER`。
    2. 常驻提权：声明 `requireAdministrator`，进程一启动就拿到高完整性（high IL）令牌。

  为什么必须常驻提权（而不是按需 asInvoker）：
    本进程要「关闭管理员窗口」，实现方式是向目标窗口 `PostMessage(WM_CLOSE)`。
    UIPI（User Interface Privilege Isolation）会拦截低完整性进程向高完整性窗口投递消息——
    asInvoker 启动的中/低完整性进程根本发不出这条消息，且是静默失败。目标窗口可能是
    管理员权限的，因此唯一可靠的做法是让自身也常驻在管理员权限下。

  注意：这里**不**声明 dpiAware / dpiAwareness，进程保持 DPI 不感知（虚拟化坐标），
  浮层的 DPI 换算（GetDpiForMonitor → scale）依赖这一点，改动前请一并调整 app.rs。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="Switcheroo.Winui"
      version="0.1.0.0"
      processorArchitecture="*"/>
  <description>Switcheroo 原生浮层</description>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
